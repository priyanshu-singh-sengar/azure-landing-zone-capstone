# ============================================================
# Terraform
# ============================================================

# Local provider plugin cache — downloaded on every `terraform init`
**/.terraform/*

# Terraform state files — remote state is used (Azure Blob Storage)
# Local state files are only present after running init/apply locally
# and must never be committed (contain plaintext resource IDs and secrets)
*.tfstate
*.tfstate.*

# Terraform plan files — binary artifacts generated by `terraform plan -out`
tfplan
tfplan-*
*.tfplan
plan-output.txt

# Crash log files generated when Terraform panics
crash.log
crash.*.log

# Terraform override files — used for local testing only, not for team use
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration files — user-local settings
.terraformrc
terraform.rc

# ============================================================
# Variable files (.tfvars)
# ============================================================
# By default, ignore all .tfvars files since they may contain
# secrets (passwords, connection strings, subscription IDs).
*.tfvars
*.tfvars.json

# Exceptions: keep .example files (safe templates without real values)
!*.tfvars.example
!*.example.tfvars

# Keep the non-sensitive environment tfvars files used by CI/CD
# (they contain only resource names, CIDRs, and toggles — no secrets)
!layers/**/*.tfvars

# ============================================================
# Credentials and secrets
# ============================================================
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
*-credentials.json
*credentials*.json
service-principal*.json
secrets.tf

# ============================================================
# OS-generated files
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================================
# Editor and IDE directories
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
*.iml
*.ipr
*.iws
.settings/
nbproject/

# ============================================================
# CI/CD and build artifacts
# ============================================================
# GitHub Actions runner working files
runner/
_runner/

# Checkov and tfsec output files
checkov-results/
tfsec-results/
results.json
results.sarif
*.sarif

# ============================================================
# Temporary and local files
# ============================================================
tmp/
temp/
*.tmp
*.bak
*.orig
*.log
!crash.log
